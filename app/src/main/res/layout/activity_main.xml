<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Camera Preview Viewfinder -->
    <FrameLayout
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/pixel_bottom_controls"
        android:layout_centerInParent="true" />

    <!-- Top Left "4K" Video Resolution Badge (Matching Screenshot 2) -->
    <TextView
        android:id="@+id/pixel_video_res_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/pixel_badge_res_bg"
        android:text="4K"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Top Quick Control Bar for Active Camera Indicators -->
    <LinearLayout
        android:id="@+id/top_indicator_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/cycle_flash"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cycle_flash"
            app:srcCompat="@drawable/flash_off"
            android:background="@drawable/pixel_btn_dark_circle"
            android:onClick="clickedCycleFlash"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/omt_streaming"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/omt_streaming"
            app:srcCompat="@drawable/ic_videocam_white_48dp"
            android:onClick="clickedOmtStreaming"
            android:background="@drawable/pixel_btn_dark_circle"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/store_location"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/preference_location_enable"
            app:srcCompat="@drawable/ic_gps_fixed_white_48dp"
            android:background="@drawable/pixel_btn_dark_circle"
            android:onClick="clickedStoreLocation"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/audio_control"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/audio_control_start"
            app:srcCompat="@drawable/ic_mic_white_48dp"
            android:background="@drawable/pixel_btn_dark_circle"
            android:onClick="clickedAudioControl"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/face_detection"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/face_detection_enable"
            app:srcCompat="@drawable/ic_face_white_48dp"
            android:background="@drawable/pixel_btn_dark_circle"
            android:onClick="clickedFaceDetection"
            android:visibility="gone" />
    </LinearLayout>

    <!-- OMT Status Text -->
    <TextView
        android:id="@+id/omt_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="70dp"
        android:text=""
        android:textColor="#FFFF00"
        android:textSize="14sp"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:visibility="gone" />

    <!-- Zoom Pill [ 1x | 2 ] (Floating on Lower Viewfinder, Matching Screenshot 1 & 2) -->
    <LinearLayout
        android:id="@+id/pixel_zoom_container"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_above="@+id/pixel_bottom_controls"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pixel_zoom_container_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/zoom_btn_1x"
            android:layout_width="32dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="1×"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/pixel_zoom_active_circle"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/zoom_btn_2x"
            android:layout_width="32dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- PIXEL CAMERA BOTTOM CONTROLS PANEL (Pitch Black #000000) -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/pixel_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="214dp"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:gravity="center_horizontal">

        <!-- ROW 1: Capture & Action Row (Gallery, Shutter, Switch Camera) -->
        <RelativeLayout
            android:id="@+id/pixel_row1_actions"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="center_vertical">

            <!-- Gallery Thumbnail Button (Left) -->
            <ImageButton
                android:id="@+id/gallery"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="26dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/gallery"
                app:srcCompat="@drawable/baseline_photo_library_white_48"
                android:background="@drawable/gallery_circle_border"
                android:onClick="clickedGallery" />

            <!-- Pause Video Button (When video recording) -->
            <ImageButton
                android:id="@+id/pause_video"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_toStartOf="@+id/take_photo"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/pause_video"
                app:srcCompat="@drawable/ic_pause_circle_outline_white_48dp"
                android:onClick="clickedPauseVideo"
                android:background="@drawable/pixel_btn_dark_circle"
                android:visibility="gone" />

            <!-- Cancel Panorama Button -->
            <ImageButton
                android:id="@+id/cancel_panorama"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_toStartOf="@+id/take_photo"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/cancel_panorama"
                app:srcCompat="@drawable/baseline_close_white_48"
                android:onClick="clickedCancelPanorama"
                android:background="@drawable/pixel_btn_dark_circle"
                android:visibility="gone" />

            <!-- Main Dual-Ring Shutter Button (Center) -->
            <ImageButton
                android:id="@+id/take_photo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_centerInParent="true"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/take_photo"
                app:srcCompat="@drawable/take_photo_selector"
                android:stateListAnimator="@animator/button_animation"
                android:onClick="clickedTakePhoto"
                android:background="@null" />

            <!-- Take Photo Snapshot Button (While Video Recording) -->
            <ImageButton
                android:id="@+id/take_photo_when_video_recording"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_toEndOf="@+id/take_photo"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/take_photo"
                app:srcCompat="@drawable/take_photo_selector"
                android:stateListAnimator="@animator/button_animation"
                android:onClick="clickedTakePhotoVideoSnapshot"
                android:background="@null"
                android:visibility="gone" />

            <!-- Switch / Flip Camera Button (Right) -->
            <ImageButton
                android:id="@+id/switch_camera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="26dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/switch_to_front_camera"
                app:srcCompat="@drawable/ic_pixel_switch_camera"
                android:stateListAnimator="@animator/button_animation"
                android:onClick="clickedSwitchCamera"
                android:background="@drawable/pixel_btn_dark_circle" />

            <!-- Multi Camera Switch (if available) -->
            <ImageButton
                android:id="@+id/switch_multi_camera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_toStartOf="@+id/switch_camera"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/switch_multi_camera"
                app:srcCompat="@drawable/baseline_add_a_photo_white_48"
                android:onClick="clickedSwitchMultiCamera"
                android:background="@drawable/pixel_btn_dark_circle"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- ROW 2: Mode Carousel Bar (Portrait, Photo, Night Sight / Video, Slow Motion) -->
        <HorizontalScrollView
            android:id="@+id/pixel_mode_scroll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="24dp">

            <LinearLayout
                android:id="@+id/pixel_mode_carousel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/mode_portrait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Portrait"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/mode_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/pixel_mode_pill_bg"
                    android:text="Photo"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/mode_night_sight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Night Sight"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/mode_panorama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Panorama"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/mode_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/pixel_mode_pill_bg"
                    android:text="Video"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mode_slow_motion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Slow Motion"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ROW 3: Utility & Switcher Bar (Settings, Photo/Video Capsule, Tune) -->
        <RelativeLayout
            android:id="@+id/pixel_row3_utility"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <!-- Settings Button (Left) -->
            <ImageButton
                android:id="@+id/settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="26dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/action_settings"
                app:srcCompat="@drawable/ic_pixel_settings"
                android:background="@drawable/pixel_btn_dark_circle"
                android:onClick="clickedSettings" />

            <!-- Center Photo / Video Mode Switcher Capsule -->
            <LinearLayout
                android:id="@+id/pixel_pv_switcher"
                android:layout_width="116dp"
                android:layout_height="42dp"
                android:layout_centerInParent="true"
                android:background="@drawable/pixel_toggle_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="3dp">

                <!-- Switch to Photo -->
                <FrameLayout
                    android:id="@+id/btn_switch_to_photo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/iv_indicator_photo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/pixel_toggle_active_circle" />

                    <ImageView
                        android:id="@+id/iv_icon_photo"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_pixel_photo_cam"
                        android:tint="#000000"
                        android:contentDescription="@string/switch_to_photo" />
                </FrameLayout>

                <!-- Switch to Video -->
                <FrameLayout
                    android:id="@+id/btn_switch_to_video"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/iv_indicator_video"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/pixel_toggle_active_circle"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/iv_icon_video"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_pixel_video_cam"
                        android:tint="#888888"
                        android:contentDescription="@string/switch_to_video" />
                </FrameLayout>
            </LinearLayout>

            <!-- Adjustments / Tune Button (Right) -->
            <ImageButton
                android:id="@+id/popup"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="26dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/action_popup"
                app:srcCompat="@drawable/ic_pixel_tune"
                android:background="@drawable/pixel_btn_dark_circle"
                android:onClick="clickedPopupSettings" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Legacy / Compatibility Views (Preserved for full feature support) -->
    <ImageButton
        android:id="@+id/switch_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        android:contentDescription="@string/switch_to_video"
        app:srcCompat="@drawable/take_video"
        android:onClick="clickedSwitchVideo" />

    <SeekBar
        android:id="@+id/zoom_seekbar"
        android:contentDescription="@string/zoom"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:visibility="gone"
        android:background="@color/seekbar_background" />

    <SeekBar
        android:id="@+id/focus_seekbar"
        android:contentDescription="@string/focus_distance"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:visibility="gone"
        android:background="@color/seekbar_background" />

    <SeekBar
        android:id="@+id/focus_bracketing_target_seekbar"
        android:contentDescription="@string/focus_bracketing_target_distance"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:visibility="gone"
        android:background="@color/seekbar_background" />

    <View
        android:id="@+id/gui_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible" />

    <ImageButton
        android:id="@+id/exposure"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/exposure"
        app:srcCompat="@drawable/ic_exposure_white_48dp"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedExposure"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/exposure_lock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/exposure_lock"
        app:srcCompat="@drawable/exposure_unlocked"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedExposureLock"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/white_balance_lock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/white_balance_lock"
        app:srcCompat="@drawable/white_balance_unlocked"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedWhiteBalanceLock"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/cycle_raw"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/cycle_raw"
        app:srcCompat="@drawable/raw_off_icon"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedCycleRaw"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/text_stamp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/preference_textstamp_summary"
        app:srcCompat="@drawable/baseline_text_fields_white_48"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedTextStamp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/stamp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/stamp_enable"
        app:srcCompat="@drawable/ic_text_format_white_48dp"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedStamp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/focus_peaking"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/focus_peaking_enable"
        app:srcCompat="@drawable/key_visualizer"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedFocusPeaking"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/auto_level"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/auto_level_enable"
        app:srcCompat="@drawable/auto_stabilise_icon"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedAutoLevel"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/kraken_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/remote_connected"
        app:srcCompat="@drawable/baseline_bluetooth_white_48"
        android:background="@drawable/pixel_btn_dark_circle"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/trash"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/trash"
        app:srcCompat="@drawable/baseline_delete_white_48"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedTrash"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/share"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/share"
        app:srcCompat="@drawable/share"
        android:background="@drawable/pixel_btn_dark_circle"
        android:onClick="clickedShare"
        android:visibility="gone" />

    <!-- Sliders Container (Manual ISO/Exposure/WB) -->
    <LinearLayout
        android:id="@+id/sliders_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/pixel_zoom_container"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:background="@drawable/pixel_zoom_container_bg"
        android:padding="8dp"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/iso_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/iso_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/exposure_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/exposure_seekbar_text"
                android:contentDescription="@string/exposure_compensation"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/ic_exposure_white_48dp" />

            <SeekBar
                android:id="@+id/exposure_seekbar"
                android:contentDescription="@string/exposure_compensation_seekbar"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/exposure_seekbar_text"
                android:layout_centerVertical="true"
                android:alpha="0.9" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/manual_exposure_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iso_seekbar_text"
                android:contentDescription="@string/iso"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/iso_icon" />

            <SeekBar
                android:id="@+id/iso_seekbar"
                android:contentDescription="@string/iso"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/iso_seekbar_text"
                android:layout_centerVertical="true"
                android:alpha="0.9" />

            <ImageView
                android:id="@+id/exposure_time_seekbar_text"
                android:contentDescription="@string/exposure_shutter_speed"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_below="@+id/iso_seekbar"
                android:layout_marginTop="8dp"
                app:srcCompat="@drawable/baseline_shutter_speed_white_48" />

            <SeekBar
                android:id="@+id/exposure_time_seekbar"
                android:contentDescription="@string/exposure_shutter_speed"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/exposure_time_seekbar_text"
                android:layout_alignTop="@+id/exposure_time_seekbar_text"
                android:layout_alignBottom="@+id/exposure_time_seekbar_text"
                android:alpha="0.9" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/manual_white_balance_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/white_balance_seekbar_text"
                android:contentDescription="@string/white_balance"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/ic_colorize_white_48dp" />

            <SeekBar
                android:id="@+id/white_balance_seekbar"
                android:contentDescription="@string/white_balance"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/white_balance_seekbar_text"
                android:layout_centerVertical="true"
                android:alpha="0.9" />
        </RelativeLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/locker"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/popup_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false" />

    <ScrollView
        android:id="@+id/hide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone"
        android:importantForAccessibility="no" />

</RelativeLayout>
