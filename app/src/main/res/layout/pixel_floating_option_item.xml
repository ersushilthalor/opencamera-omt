<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/option_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/pixel_floating_item_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/option_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Option Title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/option_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3840x2160, 16:9"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/option_item_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        app:srcCompat="@drawable/baseline_check_white_48"
        android:tint="#000000"
        android:visibility="gone"/>

</LinearLayout>
