<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/pixel_floating_window_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:layout_margin="16dp">

    <!-- Drag / Top Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#555555"/>

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/floating_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Video Resolution"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/floating_dialog_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/pixel_btn_dark_circle"
            app:srcCompat="@drawable/baseline_close_white_48"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="@string/intro_ok"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/floating_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select the recording resolution and quality"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <!-- Options Scrollable Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="380dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/floating_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

</LinearLayout>
